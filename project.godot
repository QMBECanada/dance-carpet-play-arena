; Engine configuration file.
config_version=5

[application]

config/name="Dance Carpet Play Arena"
config/version="1.0.0"
run/main_scene="res://scenes/Splash.tscn"
boot_splash/bg_color=Color(0.039, 0.07, 0.2, 1)
boot_splash/image="res://assets/portada/portada.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

MatInput="*res://scripts/Core/MatInput.cs"
Audio="*res://scripts/Core/Audio.cs"
Activity="*res://scripts/Core/Activity.cs"
CircuitRunner="*res://scripts/Screens/CircuitRunner.cs"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="AlfombraBaile"

[gui]

theme/custom_font="res://assets/fonts/Outfit-Medium.tres"

[rendering]

anti_aliasing/quality/msaa_3d=2
